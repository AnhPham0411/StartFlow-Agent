  "info": {
    "title": "StartFlow API",
    "description": "Corporate-loan multi-agent workflow API. Public events are filtered summaries only.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internal-service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-service-token"
      }
    },
    "schemas": {
      "FinancialSnapshotDto": {
        "type": "object",
        "properties": {
          "revenue": {
            "type": "number",
            "minimum": 0
          },
          "ebitda": {
            "type": "number"
          },
          "totalDebt": {
            "type": "number",
            "minimum": 0
          },
          "equity": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "currentAssets": {
            "type": "number",
            "minimum": 0
          },
          "currentLiabilities": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          }
        },
        "required": [
          "revenue",
          "ebitda",
          "totalDebt",
          "equity",
          "currentAssets",
          "currentLiabilities"
        ]
      },
      "CreateCaseDto": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "example": "Công ty Cổ phần Sao Mai Demo",
            "maxLength": 160,
            "minLength": 2
          },
          "registrationNumber": {
            "type": "string",
            "example": "DEMO-01010101",
            "maxLength": 32,
            "minLength": 4
          },
          "requestedAmount": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "purpose": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10
          },
          "financials": {
            "$ref": "#/components/schemas/FinancialSnapshotDto"
          },
          "submittedDocuments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "demoData": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          }
        },
        "required": [
          "companyName",
          "registrationNumber",
          "requestedAmount",
          "purpose",
          "financials",
          "submittedDocuments",
          "demoData"
        ]
      },
      "RecordEventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "number",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "run.started",
              "plan.created",
              "agent.started",
              "tool.completed",
              "citation.added",
              "agent.completed",
              "synthesis.completed",
              "approval.required",
              "run.completed",
              "run.failed"
            ]
          },
          "agent": {
            "type": "string",
            "enum": [
              "PLANNER",
              "CREDIT",
              "COMPLIANCE",
              "OPERATIONS",
              "SYNTHESIZER"
            ],
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 200,
            "minLength": 8
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "runId",
          "sequence",
          "type",
          "occurredAt",
          "correlationId",
          "idempotencyKey",
          "payload"
        ]
      },
      "CreateApprovalDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5
          },
          "expectedVersion": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "decision",
          "reason",
          "expectedVersion"
        ]
      },
      "IngestKnowledgeDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3
          },
          "domain": {
            "type": "string",
            "enum": [
              "CREDIT",
              "COMPLIANCE",
              "OPERATIONS"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 20
          },
          "demoData": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          }
        },
        "required": [
          "title",
          "domain",
          "content",
          "demoData"
        ]
      },
      "FeedbackDto": {
        "type": "object",
        "properties": {}
      },
      "AssignCallListDto": {
        "type": "object",
        "properties": {}
      },
      "SetKpiDto": {
        "type": "object",
        "properties": {}
      },
      "CreateNoteDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
