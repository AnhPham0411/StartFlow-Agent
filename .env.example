# ============================================================================
# CHẠY PREVIEW NHANH (BE+FE, bỏ Keycloak + Postgres tự dựng) — xem docs/DEV_PREVIEW.md
#   1. AUTH_MODE=mock  và  NEXT_PUBLIC_AUTH_MODE=mock   (dev-login, chỉ non-production)
#   2. DATABASE_URL / AI_DATABASE_URL  ->  connection string Supabase (Postgres + pgvector)
#   3. LLM tạm: giữ LLM_MODE=mock (deterministic, không cần key) HOẶC
#      LLM_MODE=openai-compatible + LLM_MODEL=gpt-4o-mini + LLM_API_KEY=<OpenAI key>
# ============================================================================

# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGINS=http://localhost:3000
DEPLOY_ENV=local
FRONTEND_PORT=3000
BACKEND_PORT=3001
STARTFLOW_NETWORK=startflow-local

# Existing PostgreSQL 18 - these services are not created by Docker Compose
DATABASE_URL=postgresql://startflow_app:[REDACTED_REQUIRED]@postgres.example.internal:5432/startflow_app?sslmode=require
AI_DATABASE_URL=postgresql://startflow_ai:[REDACTED_REQUIRED]@postgres.example.internal:5432/startflow_ai?sslmode=require
DB_SSL_MODE=require
DB_SSL_ROOT_CERT=

# Existing Keycloak - configure realm/client/roles from infra/keycloak
# AUTH_MODE=mock để dùng dev-login (bỏ Keycloak). NEXT_PUBLIC_AUTH_MODE phải khớp.
AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.example.internal
KEYCLOAK_ISSUER=https://auth.example.internal/realms/startflow
KEYCLOAK_REALM=startflow
KEYCLOAK_CLIENT_ID=startflow-web
KEYCLOAK_AUDIENCE=startflow-api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.internal
NEXT_PUBLIC_KEYCLOAK_REALM=startflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=startflow-web

# Bộ não agent: simulate = luồng mô phỏng nội bộ (LLM); external = model riêng (EXTERNAL_MODEL_URL)
AGENT_MODE=simulate
# EXTERNAL_MODEL_URL=

# AI provider (áp dụng cho AGENT_MODE=simulate); mock is deterministic and does not need an API key
LLM_MODE=mock
LLM_API_KEY=[REDACTED_REQUIRED_WHEN_LIVE]
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

# Internal trust boundary
INTERNAL_SERVICE_TOKEN=[REDACTED_REQUIRED]
INTERNAL_CALLBACK_URL=http://backend:3001/internal/ai/events
