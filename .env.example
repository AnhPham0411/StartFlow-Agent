# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGINS=http://localhost:3000
DEPLOY_ENV=local
FRONTEND_PORT=3000
BACKEND_PORT=3001
STARTFLOW_NETWORK=startflow-local

# Existing PostgreSQL 18 - these services are not created by Docker Compose
DATABASE_URL=postgresql://startflow_app:[REDACTED_REQUIRED]@postgres.example.internal:5432/startflow_app?sslmode=require
AI_DATABASE_URL=postgresql://startflow_ai:[REDACTED_REQUIRED]@postgres.example.internal:5432/startflow_ai?sslmode=require
DB_SSL_MODE=require
DB_SSL_ROOT_CERT=

# Existing Keycloak - configure realm/client/roles from infra/keycloak
AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.example.internal
KEYCLOAK_ISSUER=https://auth.example.internal/realms/startflow
KEYCLOAK_REALM=startflow
KEYCLOAK_CLIENT_ID=startflow-web
KEYCLOAK_AUDIENCE=startflow-api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.internal
NEXT_PUBLIC_KEYCLOAK_REALM=startflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=startflow-web

# Internal local VLM/orchestrator endpoint. It receives multipart prompt/history/files.
# Leave empty only for the deterministic UI demo fallback.
STARTFLOW_ASSISTANT_URL=

# Shared-filesystem relay to the offline Slurm GPU worker. Keep the secret at mode 0600.
STARTFLOW_HPC_SPOOL_DIR=/scratch/USER/startflow-assistant/spool
STARTFLOW_HPC_SECRET_FILE=/scratch/USER/startflow-assistant/spool-secret
STARTFLOW_HPC_TIMEOUT_MS=90000

# AI provider. The demo is local/HPC-only; do not point this at a public model API.
LLM_MODE=mock
LLM_API_KEY=[NOT_REQUIRED_FOR_LOCAL]
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_TOP_K=5

# Internal trust boundary
INTERNAL_SERVICE_TOKEN=[REDACTED_REQUIRED]
INTERNAL_CALLBACK_URL=http://backend:3001/internal/ai/events
