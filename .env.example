# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3200
API_URL=http://localhost:3201
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGINS=http://localhost:3200
APP_DOMAIN=CHANGE_ME_APP_DOMAIN
API_DOMAIN=CHANGE_ME_API_DOMAIN
DEPLOY_ENV=local
FRONTEND_PORT=3200
BACKEND_PORT=3201
STARTFLOW_NETWORK=startflow-local

# Required only when this file is stored as the GitHub secret STARTFLOW_DEV
DROPLET_HOST=CHANGE_ME_DROPLET_HOST
DROPLET_USER=deploy
DROPLET_SSH_KNOWN_HOSTS=CHANGE_ME_VERIFIED_KNOWN_HOST_LINE
POSTGRES_CA_CERT_BASE64=

# Existing PostgreSQL 18 - runtime entrypoints build the private DSNs in memory
# Keep DB_PASSWORD as the raw password; do not URL-encode it here.
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=startflow_app
DB_USER=startflow_app
DB_PASSWORD=[REDACTED_REQUIRED]
DB_SSL_MODE=require
DB_SSL_ROOT_CERT=

# Existing Keycloak - configure realm/client/roles from infra/keycloak
AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.example.internal
KEYCLOAK_ISSUER=https://auth.example.internal/realms/startflow
KEYCLOAK_REALM=startflow
KEYCLOAK_CLIENT_ID=startflow-web
KEYCLOAK_AUDIENCE=startflow-api
NEXT_PUBLIC_API_URL=http://localhost:3201/api
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.internal
NEXT_PUBLIC_KEYCLOAK_REALM=startflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=startflow-web

# AI provider; mock is deterministic and does not need an API key
LLM_MODE=mock
LLM_API_KEY=[REDACTED_REQUIRED_WHEN_LIVE]
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

# Existing Qdrant vector store
QDRANT_URL=https://qdrant.example.internal
QDRANT_API_KEY=[REDACTED_REQUIRED]
QDRANT_COLLECTION=startflow_knowledge
QDRANT_VECTOR_SIZE=1536

# Internal trust boundary
INTERNAL_SERVICE_TOKEN=[REDACTED_REQUIRED]
INTERNAL_CALLBACK_URL=http://backend:3001/internal/ai/events
