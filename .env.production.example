NODE_ENV=production
LOG_LEVEL=info
APP_URL=https://startflow.example.com
API_URL=https://api.startflow.example.com
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGINS=https://startflow.example.com
APP_DOMAIN=startflow.example.com
API_DOMAIN=api.startflow.example.com
DEPLOY_ENV=prod
FRONTEND_PORT=3300
BACKEND_PORT=3301
STARTFLOW_NETWORK=startflow-prod

# Deployment transport metadata carried inside STARTFLOW_PROD
DROPLET_HOST=CHANGE_ME_DROPLET_HOST
DROPLET_USER=deploy
DROPLET_SSH_KNOWN_HOSTS=CHANGE_ME_VERIFIED_KNOWN_HOST_LINE
POSTGRES_CA_CERT_BASE64=

# Keep DB_PASSWORD as the raw password; runtime entrypoints URL-encode it.
DB_HOST=postgres.example.com
DB_PORT=5432
DB_NAME=startflow_app
DB_USER=startflow_app
DB_PASSWORD=[REDACTED_REQUIRED]
DB_SSL_MODE=verify-full
DB_SSL_ROOT_CERT=/run/secrets/postgres-ca.crt

# Backend client/audience is hardcoded as INTEGRATION_API. The public frontend
# client's access token must include that audience.
AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/startflow
KEYCLOAK_REALM=startflow
KEYCLOAK_SECRET=[REDACTED_REQUIRED]
NEXT_PUBLIC_API_URL=https://api.startflow.example.com/api
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_KEYCLOAK_REALM=startflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=portal-ops

LLM_MODE=openai-compatible
LLM_API_KEY=[REDACTED_REQUIRED]
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=[REDACTED_REQUIRED]
QDRANT_COLLECTION=startflow_knowledge
QDRANT_VECTOR_SIZE=1536

INTERNAL_SERVICE_TOKEN=[REDACTED_REQUIRED]
INTERNAL_CALLBACK_URL=http://backend:3001/internal/ai/events
