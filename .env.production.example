NODE_ENV=production
LOG_LEVEL=info
APP_URL=https://startflow.example.com
API_URL=https://api.startflow.example.com
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGINS=https://startflow.example.com
APP_DOMAIN=startflow.example.com
API_DOMAIN=api.startflow.example.com
DEPLOY_ENV=prod
FRONTEND_PORT=3200
BACKEND_PORT=3201
STARTFLOW_NETWORK=startflow-prod

DATABASE_URL=postgresql://startflow_app:[REDACTED_REQUIRED]@postgres.example.com:5432/startflow_app?sslmode=verify-full
AI_DATABASE_URL=postgresql://startflow_ai:[REDACTED_REQUIRED]@postgres.example.com:5432/startflow_ai?sslmode=verify-full
DB_SSL_MODE=verify-full
DB_SSL_ROOT_CERT=/run/secrets/postgres-ca.crt
POSTGRES_CA_CERT_PATH=./postgres-ca.crt

AUTH_MODE=keycloak
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/startflow
KEYCLOAK_REALM=startflow
KEYCLOAK_CLIENT_ID=startflow-web
KEYCLOAK_AUDIENCE=startflow-api
NEXT_PUBLIC_API_URL=https://api.startflow.example.com/api
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_KEYCLOAK_REALM=startflow
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=startflow-web

LLM_MODE=local-hpc-spool
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen3.5-9B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_TOP_K=5

STARTFLOW_HPC_SPOOL_DIR=/run/startflow/spool
STARTFLOW_HPC_SECRET_FILE=/run/secrets/startflow-spool-secret
STARTFLOW_HPC_TIMEOUT_MS=90000

INTERNAL_SERVICE_TOKEN=[REDACTED_REQUIRED]
INTERNAL_CALLBACK_URL=http://backend:3001/internal/ai/events
