{
  "name": "@startflow/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ng serve --configuration local --host 0.0.0.0 --port 3000",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "build:local": "ng build --configuration local",
    "build:production": "ng build --configuration production",
    "start": "ng serve --configuration local --host 0.0.0.0 --port 3000",
    "lint": "ng lint",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "typecheck": "ngc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/animations": "~20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "~20.3.25",
    "@angular/compiler": "~20.3.25",
    "@angular/core": "~20.3.25",
    "@angular/forms": "~20.3.25",
    "@angular/material": "^20.2.14",
    "@angular/material-date-fns-adapter": "^20.2.14",
    "@angular/platform-browser": "~20.3.25",
    "@angular/platform-browser-dynamic": "~20.3.25",
    "@angular/router": "~20.3.25",
    "@sdcorejs/angular": "^20.1.2",
    "@sdcorejs/utils": "^1.1.4",
    "@startflow/contracts": "workspace:*",
    "date-fns": "^3.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "~20.3.29",
